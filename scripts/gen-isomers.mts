// Generates the isomer tables of the Molecule Studio: npm run gen:isomers -- --jar <path to MAYGEN-1.8.jar>
//
// DEV / CI MACHINES ONLY. It runs MAYGEN (Java 8+, MIT license, https://github.com/MehmetAzizYirik/MAYGEN) as an external
// tool and keeps only its OUTPUT: app/_molecule/data/isomers/<formula>.json (and the generated index.ts). Java is never needed
// at run time and MAYGEN is not vendored.
//
//   1. download MAYGEN-1.8.jar from the project's releases (keep it outside the repo)
//   2. npm run gen:isomers -- --jar /path/to/MAYGEN-1.8.jar [--only C2H4O2,C4H10] [--timeout 180]
//
// Options:  --only a,b   only these formulas (the index is rebuilt from the files on disk)
//           --timeout s  give up on a formula after s seconds (default 180); it is reported and skipped
//           --max n      skip formulas with more than n structures (default 30000): they are heteroatom-rich oddities no school
//                        uses, and the tables would be dominated by structures nobody can browse
//           --resume     skip the formulas that already have a table
import { spawnSync } from "node:child_process";
import { createRequire } from "node:module";
import { existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import type { MainModule } from "@rdkit/rdkit";
import { createRdkitEngine } from "../app/_molecule/engine/rdkitEngine";
import { buildIsomerFile } from "../app/_molecule/isomers/build";
import { isomerFormulas } from "../app/_molecule/isomers/formulas";
import type { IsomerFile } from "../app/_molecule/isomers/types";

const args = process.argv.slice(2);
const opt = (name: string) => {
  const i = args.indexOf(`--${name}`);
  return i >= 0 ? args[i + 1] : undefined;
};
const jar = opt("jar") ?? process.env.MAYGEN_JAR;
const only = opt("only")?.split(",").map((s) => s.trim()).filter(Boolean);
const timeoutS = Number(opt("timeout") ?? 180);
const maxStructures = Number(opt("max") ?? 30000);
const resume = args.includes("--resume");
const outDir = join(import.meta.dirname, "../app/_molecule/data/isomers");

mkdirSync(outDir, { recursive: true });
const require = createRequire(import.meta.url);
const engine = createRdkitEngine(() => (require("@rdkit/rdkit") as () => Promise<MainModule>)());

// One file per formula, one isomer per line (small diffs when the rules change).
const toJson = (f: IsomerFile) =>
  `{\n  "formula": ${JSON.stringify(f.formula)},\n  "total": ${f.total},\n  "schoolTotal": ${f.schoolTotal},\n  "entries": [\n${f.entries.map((e) => "    " + JSON.stringify(e)).join(",\n")}\n  ]\n}\n`;

function writeIndex() {
  const formulas = readdirSync(outDir).filter((n) => n.endsWith(".json")).map((n) => n.slice(0, -5)).sort((a, b) => a.localeCompare(b, "en", { numeric: true }));
  const lines = formulas.map((f) => `  "${f}": () => import("./${f}.json").then((m) => m.default as unknown as IsomerFile),`);
  writeFileSync(
    join(outDir, "index.ts"),
    `// GENERATED by scripts/gen-isomers.mts: do not edit. One lazy loader per formula (each file is its own chunk).\nimport type { IsomerFile } from "../../isomers/types";\n\nexport const ISOMER_LOADERS: Record<string, () => Promise<IsomerFile>> = {\n${lines.join("\n")}\n};\n`,
  );
  console.log(`index.ts: ${formulas.length} formulas`);
}

if (!jar && !only) {
  console.error("Missing --jar <MAYGEN-1.8.jar> (or the MAYGEN_JAR environment variable).");
  process.exit(1);
}

if (jar) {
  if (!existsSync(jar)) {
    console.error(`MAYGEN jar not found: ${jar}`);
    process.exit(1);
  }
  const java = spawnSync("java", ["-version"], { encoding: "utf8" });
  if (java.error) {
    console.error("Java is not installed (MAYGEN needs Java 8 or newer, on this machine only).");
    process.exit(1);
  }
  const work = mkdtempSync(join(tmpdir(), "maygen-"));
  const formulas = only ?? isomerFormulas();
  let done = 0;
  const skipped: string[] = [];
  const t0 = Date.now();
  for (const formula of formulas) {
    if (resume && existsSync(join(outDir, `${formula}.json`))) continue;
    const run = spawnSync("java", ["-jar", jar, "-f", formula, "-smi", "-o", join(work, formula)], { encoding: "utf8", timeout: timeoutS * 1000, maxBuffer: 1 << 26 });
    const smi = join(work, formula, `${formula}.smi`);
    const target = join(outDir, `${formula}.json`);
    if (run.error || !existsSync(smi)) {
      skipped.push(`${formula} (${run.error ? "timeout" : "no output"})`);
      continue;
    }
    const lines = readFileSync(smi, "utf8").split(/\r?\n/);
    if (lines.length > maxStructures) {
      skipped.push(`${formula} (${lines.length} structures)`);
      if (existsSync(target)) rmSync(target);
      continue;
    }
    const file = await buildIsomerFile(engine, formula, lines);
    if (file.total < 2) {
      if (existsSync(target)) rmSync(target); // a formula with one structure has nothing to browse
      continue;
    }
    writeFileSync(target, toJson(file));
    done++;
    console.log(`${formula.padEnd(14)} ${String(file.total).padStart(6)} structures, ${String(file.schoolTotal).padStart(5)} school, ${file.entries.length} kept`);
  }
  rmSync(work, { recursive: true, force: true });
  // A full run leaves exactly the tables of the current formula list (no stale files from an older list).
  if (!only) {
    const keep = new Set(formulas);
    for (const n of readdirSync(outDir)) if (n.endsWith(".json") && !keep.has(n.slice(0, -5))) rmSync(join(outDir, n));
  }
  // Tables made with a looser --max are dropped too, so the folder always follows the current limit.
  for (const n of readdirSync(outDir)) {
    if (!n.endsWith(".json")) continue;
    const total = Number(/"total": (\d+)/.exec(readFileSync(join(outDir, n), "utf8"))?.[1] ?? 0);
    if (total > maxStructures) rmSync(join(outDir, n));
  }
  console.log(`\n${done} tables written in ${Math.round((Date.now() - t0) / 1000)} s.`);
  if (skipped.length) console.log(`Skipped: ${skipped.join(", ")}`);
}
writeIndex();
